.{
    .name = .zigma_definition,
    .version = "0.1.0",
    .fingerprint = 0x80e6c10ecfc91c39, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0-dev.1818+7051f8e73",
    .dependencies = .{},
    // What goes into the published package (and therefore into its hash).
    // The tests stay in the repository; they are just not shipped: a consumer
    // never runs them, and they are bigger than the framework itself.
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
        "LICENSE",
    },
}
